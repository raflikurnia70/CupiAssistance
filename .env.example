# DataSense AI supports two LLM providers - fill in the one whose API key you have.
#
# LLM_PROVIDER picks which one to use explicitly: "groq" or "gemini".
# If left blank, the app auto-detects based on which key below is set
# (Groq takes priority if both are present).
LLM_PROVIDER=gemini

# --- Option A: Groq (Llama models) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option B: Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
